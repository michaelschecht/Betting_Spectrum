# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADVISOR_PASSCODE: Shared passcode that unlocks the Gemini strategy advisor.
# REQUIRED for the advisor to work at all - if unset, /api/strategy-advisor
# fails closed with 503 and the advisor panel shows as unavailable. This exists
# so strangers cannot burn the metered GEMINI_API_KEY.
ADVISOR_PASSCODE="MY_ADVISOR_PASSCODE"

# ADVISOR_SECRET: Optional. Long random string used to sign advisor session
# cookies. If unset, the signing key is derived from ADVISOR_PASSCODE, which
# means rotating the passcode invalidates all existing sessions.
ADVISOR_SECRET=""
